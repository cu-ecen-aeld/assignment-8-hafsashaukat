#!/bin/sh

case "$1" in
    start)
        echo "Loading aesdchar kernel module"

        modprobe aesdchar || exit 1

        # Create the device node if it does not already exist
        if [ ! -e /dev/aesdchar ]; then
            major=$(awk '$2 == "aesdchar" {print $1}' /proc/devices)

            if [ -z "$major" ]; then
                echo "Could not determine aesdchar major number"
                exit 1
            fi

            mknod /dev/aesdchar c "$major" 0
        fi

        chmod 666 /dev/aesdchar
        ;;

    stop)
        echo "Unloading aesdchar kernel module"
        rmmod aesdchar
        rm -f /dev/aesdchar
        ;;

    restart)
        "$0" stop
        "$0" start
        ;;

    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
